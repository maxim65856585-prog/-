"""
Wallpaper Changer
Меняет обои на картинку из папки (случайно) с заданным интервалом.
Работает на Windows / Linux (GNOME) / macOS.
Умеет сохранять и возвращать старые обои.
"""

import os
import sys
import time
import random
import platform
import subprocess
import ctypes

# ============ НАСТРОЙКИ ============
FOLDER = r"C:\pictures\wallpapers"   # папка с картинками
INTERVAL = 60                        # секунд между сменой
SAVE_ORIGINAL = True                 # сохранить старые обои
ONCE = False                         # True = сменить один раз и выйти
# ===================================

SYSTEM = platform.system()


# ---------- Windows ----------
def win_set(path):
    path = os.path.abspath(path)
    ctypes.windll.user32.SystemParametersInfoW(20, 0, path, 3)


def win_get():
    buf = ctypes.create_unicode_buffer(512)
    ctypes.windll.user32.SystemParametersInfoW(0x0073, 512, buf, 0)
    return buf.value


# ---------- Linux (GNOME) ----------
def linux_set(path):
    uri = "file://" + os.path.abspath(path)
    subprocess.run(["gsettings", "set",
                    "org.gnome.desktop.background",
                    "picture-uri", uri], check=False)
    subprocess.run(["gsettings", "set",
                    "org.gnome.desktop.background",
                    "picture-uri-dark", uri], check=False)


def linux_get():
    try:
        return subprocess.check_output(
            ["gsettings", "get",
             "org.gnome.desktop.background",
             "picture-uri"]
        ).decode().strip().replace("file://", "").strip("'")
    except Exception:
        return ""


# ---------- macOS ----------
def mac_set(path):
    path = os.path.abspath(path)
    script = f'tell application "System Events" to set picture of every desktop to "{path}"'
    subprocess.run(["osascript", "-e", script], check=False)


def mac_get():
    try:
        out = subprocess.check_output([
            "osascript", "-e",
            'tell application "System Events" to get picture of desktop 1'
        ]).decode().strip()
        return out
    except Exception:
        return ""


# ---------- Универсальные обёртки ----------
def set_wallpaper(path):
    if SYSTEM == "Windows":
        win_set(path)
    elif SYSTEM == "Darwin":
        mac_set(path)
    elif SYSTEM == "Linux":
        linux_set(path)
    else:
        raise RuntimeError(f"ОС не поддерживается: {SYSTEM}")


def get_wallpaper():
    if SYSTEM == "Windows":
        return win_get()
    if SYSTEM == "Darwin":
        return mac_get()
    if SYSTEM == "Linux":
        return linux_get()
    return ""


# ---------- Основная логика ----------
def list_images(folder):
    exts = (".jpg", ".jpeg", ".png", ".bmp", ".webp")
    if not os.path.isdir(folder):
        return []
    return [os.path.join(folder, f)
            for f in os.listdir(folder)
            if f.lower().endswith(exts)]


def main():
    images = list_images(FOLDER)
    if not images:
        print(f"[!] В папке нет картинок: {FOLDER}")
        sys.exit(1)

    original = get_wallpaper() if SAVE_ORIGINAL else None
    if original:
        print(f"[i] Старые обои сохранены: {original}")

    try:
        while True:
            img = random.choice(images)
            set_wallpaper(img)
            print(f"[+] Обои -> {img}")
            if ONCE:
                break
            time.sleep(INTERVAL)
    except KeyboardInterrupt:
        print("\n[i] Остановлено пользователем.")
        if SAVE_ORIGINAL and original and os.path.exists(original):
            set_wallpaper(original)
            print(f"[i] Вернул старые обои: {original}")


if __name__ == "__main__":
    main()
